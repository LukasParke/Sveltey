# Supabase (required)
PUBLIC_SUPABASE_URL="YOUR_SUPABASE_URL"
PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Supabase service role key — SERVER-SIDE ONLY, never expose to the client.
# Required for Stripe webhooks to persist subscription state.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Resend (contact form email delivery)
RESEND_API_KEY="YOUR_RESEND_KEY"
CONTACT_FROM_EMAIL="Sveltey Contact <onboarding@resend.dev>"
CONTACT_TO_EMAIL="where@to.deliver"

# Stripe (payments)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# Webhook signing secret (docs/PAYMENTS_SETUP.md)
STRIPE_WEBHOOK_SECRET="whsec_..."
# Optional: existing Stripe Price IDs. Without them, checkout uses inline
# price_data from src/lib/config/plans.ts.
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""
